VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional Gemini proxy URL used by the client if AI features are enabled.
# In local development you can leave this empty and rely on the same-origin /api/gemini route.
# In production, point it to your deployed Vercel Edge Function if needed.
# VITE_GEMINI_PROXY_URL=https://your-project.vercel.app/api/gemini

# Gemini API key (server-side only - set in Vercel project env vars, never in the client bundle)
GEMINI_API_KEY=your_gemini_api_key
